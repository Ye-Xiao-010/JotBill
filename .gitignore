# Git worktrees (local only)
.worktrees/
**/debug.keystore

# Generated Android artifacts and reports
*.apk
*.aab
coverage/
**/build/

# Local Gradle cache and temporary build directory
.tmp-gradle-build/
.tmp-gradle-tmp/

# Roadmap baseline (2026-08-28): 真机诊断临时件/构建缓存/工具残留,一律不进仓库
.tmp-*
.gradle-build-home-*/
.gradle-project-cache-*/
.workbuddy/
/ui*.xml
/tmp-*.xml
/commit-msg.txt

