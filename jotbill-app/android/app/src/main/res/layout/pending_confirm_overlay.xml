<?xml version="1.0" encoding="utf-8"?>
<!-- 付款确认弹窗:移植自 LiteNote payment_overlay.xml(Neo-Brutalism),
    增加商户行/可编辑金额/账户 chips;数据源为本地待确认确认入口 -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="4dp"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bg_card_neo"
        android:clipToPadding="false">

        <!-- 主内容区域 -->
        <LinearLayout
            android:id="@+id/content_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- 标题栏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💰 确认入账"
                    android:textSize="20sp"
                    android:textColor="#1A1A1A"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_close_x"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_close_btn_neo"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:contentDescription="关闭"
                    android:scaleType="centerInside"
                    android:padding="6dp" />
            </LinearLayout>

            <!-- 来源提示 -->
            <TextView
                android:id="@+id/tv_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="检测到一笔待确认支付"
                android:textSize="14sp"
                android:textColor="#1A1A1A"
                android:textStyle="bold"
                android:background="@drawable/bg_source_banner"
                android:padding="12dp"
                android:gravity="center" />

            <!-- 商户行:证据/AI 识别结果,可核对。精简版下结算页 AI 已停用,
                 商户只靠支付结果页文本解析,可能为空;为空时整行隐藏(见
                 PendingConfirmOverlayManager.displayOverlay),不显示"未知" -->
            <TextView
                android:id="@+id/tv_merchant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="商户：未知"
                android:textSize="14sp"
                android:textColor="#404040"
                android:textStyle="bold" />

            <!-- 金额输入:预填证据/AI 金额,可修正 -->
            <EditText
                android:id="@+id/et_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="0.00"
                android:textSize="36sp"
                android:textColor="#EF4444"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:maxLength="12"
                android:background="@drawable/btn_outline_gray"
                android:paddingVertical="6dp" />

            <!-- 账户选择:支出必填,默认取待确认携带的支付账户 -->
            <TextView
                android:id="@+id/tv_account_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="选择账户"
                android:textSize="14sp"
                android:textColor="#1A1A1A"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:id="@+id/scroll_accounts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none"
                android:overScrollMode="never">

                <LinearLayout
                    android:id="@+id/container_accounts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- 备注输入:精简版下这是用户唯一能补"买了什么"的地方(结算页 AI 已停用,
                     商品描述不再由识别链路填充),因此 hint 直接说清用途 -->
            <EditText
                android:id="@+id/et_remark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="44dp"
                android:background="@drawable/btn_outline_gray"
                android:gravity="top|start"
                android:hint="买了什么？（可选）"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="3"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:textColor="#1A1A1A"
                android:textColorHint="#737373"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- 分类选择标签 -->
            <TextView
                android:id="@+id/tv_category_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="选择分类"
                android:textSize="14sp"
                android:textColor="#1A1A1A"
                android:textStyle="bold" />

            <ScrollView
                android:id="@+id/scroll_categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none"
                android:overScrollMode="never">

                <LinearLayout
                    android:id="@+id/container_categories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <!-- 加载状态 -->
            <LinearLayout
                android:id="@+id/loading_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:indeterminate="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="加载分类中..."
                    android:textSize="13sp"
                    android:textColor="#737373"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- 按钮区域 -->
            <LinearLayout
                android:id="@+id/buttons_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_close"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:text="稍后"
                    android:textSize="15sp"
                    android:textColor="#1A1A1A"
                    android:textStyle="bold"
                    android:background="@drawable/btn_outline_gray"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btn_confirm"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="确认入账"
                    android:textSize="15sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/btn_primary"
                    android:enabled="false"
                    android:alpha="0.5"
                    android:textAllCaps="false" />
            </LinearLayout>

        </LinearLayout>

        <!-- 成功反馈区域 -->
        <LinearLayout
            android:id="@+id/content_success"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="40dp"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:text="✓"
                android:textSize="32sp"
                android:textColor="#22C55E"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_success_neo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="入账成功"
                android:textSize="20sp"
                android:textColor="#1A1A1A"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_success_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="¥0.00 - 分类"
                android:textSize="15sp"
                android:textColor="#404040"
                android:fontFamily="monospace"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 失败反馈区域 -->
        <LinearLayout
            android:id="@+id/content_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="40dp"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:text="✗"
                android:textSize="32sp"
                android:textColor="#EF4444"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_error_neo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="入账失败"
                android:textSize="20sp"
                android:textColor="#1A1A1A"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_error_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="请稍后重试"
                android:textSize="14sp"
                android:textColor="#404040" />

            <Button
                android:id="@+id/btn_retry"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="20dp"
                android:paddingHorizontal="32dp"
                android:text="重试"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/btn_primary"
                android:textAllCaps="false" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
