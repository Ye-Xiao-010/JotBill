  "com.android.mms/android.app.Notification": [
   {
    "note": "招商银行-支出",
    "locateAttribute": 0,
    "locateToken": "招商银行",
    "locateMaxTraverseCount": 32,
    "fromApp": 4,
    "extractPattern": "(?s)[\\[【]\\s*(.+?)\\s*[\\]】]\\s*您账户\\s*(\\d+)于\\s*(\\d+月\\d+日\\d+:\\d+)在[\\[【]\\s*(.+?)\\s*[\\]】]\\s*发生快捷支付扣款，人民币\\s*(\\d+\\.\\d+)",
    "extractFields": {
     "bank": 1,
     "card": 2,
     "businessTime": 3,
     "method": 4,
     "amount": 5
    },
    "ruleId": 1000033,
    "rulePkgId": 2000016
   },
   {
    "ruleType": "singleField",
    "note": "银行短信字段提取",
    "necessaryFields": [
     "detailType",
     "amount"
    ],
    "locateAttribute": 0,
    "locatePattern": "(?s)[\\[【]\\s*(.+?)(?:银行)?\\s*[\\]】]",
    "locateMaxTraverseCount": 5,
    "singleFieldExtractPattern": {
     "orgName": [
      {
       "pattern": "(?s)[\\[【]\\s*(.+?银行)\\s*[\\]】]"
      },
      {
       "pattern": "(?s).*?[\\[【]\\s*(.+?银行)\\s*[\\]】]$"
      },
      {
       "pattern": "(?s)[\\[【]\\s*(.+?)\\s*[\\]】]"
      },
      {
       "pattern": "(?s).*?[\\[【]\\s*(.+?)\\s*[\\]】]$"
      }
     ],
     "card": [
      {
       "pattern": "(?s)(?:您|贵)(?:账户|卡号)\\s*(\\d+)"
      },
      {
       "pattern": "(?s)(?:您|贵)?尾号(\\d+)(?:的)?(?:储蓄)?卡"
      },
      {
       "pattern": "(?s)卡号(\\d+)(?:日|$)"
      },
      {
       "pattern": "(?s)向您尾号(\\d+)的账户"
      }
     ],
     "businessTime": [
      {
       "pattern": "(?s)(?:于)?\\s*((\\d{2}|\\d{4})年\\d{1,2}月\\d{1,2}日\\d{1,2}:\\d{1,2}:\\d{1,2})"
      },
      {
       "pattern": "(?s)(?:于)?\\s*((\\d{2}|\\d{4})年\\d{1,2}月\\d{1,2}日\\d{1,2}:\\d{1,2})"
      },
      {
       "pattern": "(?s)(?:于)?\\s*(\\d{1,2}月\\d{1,2}日\\d{1,2}[时:]\\d{1,2}[分:]\\d{1,2}[秒]?)"
      },
      {
       "pattern": "(?s)(?:于)?\\s*(\\d{1,2}月\\d{1,2}日\\d{1,2}[时:]\\d{1,2}[分]?)"
      },
      {
       "pattern": "(?s)(?:于)?\\s*(\\d{1,2}月\\d{1,2}日\\d{1,2}:\\d{1,2})"
      },
      {
       "pattern": "(?s)(?:于)?\\s*(\\d{1,2}月\\d{1,2}日)"
      }
     ],
     "detailType": [
      {
       "pattern": "(?s)(?:他行实时转入|入账工资|入账住房公积金|入账综合代发|入账报销款|入贷款项|转入|存入|收入|收到汇款|财付通快捷支付存入|代发工资存入|转入已到帐|跨行代付收入|银联入账|增加人民币)",
       "staticValue": "1"
      },
      {
       "pattern": "(?s)(?:发生快捷支付扣款|完成.*?交易人民币\\s*-|支取|支付|支出|取出|扣款|柜台取款|取现|减少人民币|ATM取款|转账|汇款转出|对外汇款支出|消费|快捷支付支出|自动还款)",
       "staticValue": "2"
      },
      {
       "pattern": "(?s)成功退货",
       "staticValue": "1"
      },
      {
       "pattern": "(?s)有?\\s*\\d+(?:[,，]\\d+)*(?:\\.\\d+)?(?:元)?的(.+?)交易",
       "staticValue": "2"
      }
     ],
     "amount": [
      {
       "pattern": "(?s)(?:人民币|RMB)\\s*(-?\\d+(?:[,，]\\d+)*(?:\\.\\d+)?)(?:元|$|，|,|。|\\s|[^0-9.,，])"
      },
      {
       "pattern": "(?s)(?:金额|交易金额)\\s*(\\d+(?:[,，]\\d+)*(?:\\.\\d+)?)(?:元|$|，|,|\\s)"
      },
      {
       "pattern": "(?s)(?:支出|收入|消费|支付|取出|扣款|柜台取款|取现|转账|汇款转出|存入)(?:\\([^)）]*\\)|（[^)）]*）)?\\s*(\\d+(?:[,，]\\d+)*(?:\\.\\d+)?)(?:元|$|，|,|\\s)"
      },
      {
       "pattern": "(?s)完成.*?交易人民币\\s*(-?\\d+(?:[,，]\\d+)*(?:\\.\\d+)?)"
      },
      {
       "pattern": "(?s)有(?:人民币|美元)?\\s*(\\d+(?:[,，]\\d+)*(?:\\.\\d+)?)(?:元)?的"
      }
     ],
     "counterparty": [
      {
       "pattern": "(?s)，付方(.+?)\\s"
      },
      {
       "pattern": "(?s)支出\\(消费(.+?)\\)"
      },
      {
       "pattern": "(?s)支出（消费(.+?)）"
      },
      {
       "pattern": "(?s)对方户名:(.+?)对方账户尾号"
      },
      {
       "pattern": "(?s)附言:(.+?)(?:。)?[\\[【]"
      },
      {
       "pattern": "(?s)向(.+?)转账"
      },
      {
       "pattern": "(?s)给尾号为\\d+的账户转账(.+?)元"
      },
      {
       "pattern": "(?s)(.+?)(\\d+月\\d+日\\d+:\\d+)向您尾号"
      }
     ],
     "counterpartyCard": [
      {
       "pattern": "(?s)对方账户尾号:\\s*(\\d+)"
      },
      {
       "pattern": "(?s)转出方卡号(\\d+)"
      },
      {
       "pattern": "(?s)给尾号为(\\d+)的账户转账"
      }
     ],
     "method": [
      {
       "pattern": "(?s)在[\\[【]\\s*(.+?)\\s*[\\]】]\\s*发生快捷支付扣款"
      },
      {
       "pattern": "(?s)完成(财付通)交易"
      },
      {
       "pattern": "(?s)完成(支付宝)交易"
      },
      {
       "pattern": "(?s)完成(银联)交易"
      },
      {
       "pattern": "(?s)完成(网银在线)交易"
      },
      {
       "pattern": "(?s)完成(抖音支付)交易"
      },
      {
       "pattern": "(?s)(手机银行)支取"
      },
      {
       "pattern": "(?s)(快捷支付)支出"
      },
      {
       "pattern": "(?s)(POS)支取"
      },
      {
       "pattern": "(?s)(ATM)取款"
      },
      {
       "pattern": "(?s)(柜台)取款"
      },
      {
       "pattern": "(?s)(财付通快捷支付)存入"
      },
      {
       "pattern": "(?s)(银联)入账"
      },
      {
       "pattern": "(?s)(银联)扣款"
      },
      {
       "pattern": "(?s)有?\\s*\\d+(?:[,，]\\d+)*(?:\\.\\d+)?(?:元)?的(.+?)交易"
      }
     ],
     "currency": [
      {
       "pattern": "(?s)有(USD)\\d+(?:\\.\\d+)?元"
      },
      {
       "pattern": "(?s)有(美元)\\d+(?:\\.\\d+)?元",
       "staticValue": "USD"
      },
      {
       "pattern": "(?s)(?:人民币|RMB)",
       "staticValue": "CNY"
      }
     ],
     "balance": [
      {
       "pattern": "(?s)(?:余额|当前余额|可用余额)(?:为)?(?:人民币)?\\s*(\\d+(?:[,，]\\d+)*(?:\\.\\d+)?)(?:元|$|，|,|\\s)"
      },
      {
       "pattern": "(?s)余额(?:为)?(?:人民币)?\\s*(\\d+(?:[,，]\\d+)*(?:\\.\\d+)?)"
      }
     ]
    },
    "ruleId": 2000106,
    "rulePkgId": 2000016
   },
   {
